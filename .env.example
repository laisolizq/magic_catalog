# Local card database testing. Copy to .env.local after generating the artifact.
VITE_CATALOG_DATABASE_URL=http://localhost:8080/catalog.sqlite.gz
VITE_CATALOG_METADATA_URL=http://localhost:8080/metadata.json

# Optional starter catalog override (small bootstrap DB used when no local DB exists).
# If unset, the app uses /card-database/bootstrap/* from the deployed site.
# VITE_CATALOG_BOOTSTRAP_DATABASE_URL=http://localhost:8080/bootstrap/catalog.sqlite.gz
# VITE_CATALOG_BOOTSTRAP_METADATA_URL=http://localhost:8080/bootstrap/metadata.json